# Environment Configuration
# Copy this file to .env and adjust as needed for your environment

# MongoDB Connection URI (Default local standalone or replica set)
MONGO_URI=mongodb://127.0.0.1:27017

# Database Name for the Project
DB_NAME=airline_reservation_db

# Web Server Port
PORT=3000

# Node Environment
NODE_ENV=development

# Admin Authentication Credentials (Configure your own in .env)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password
SESSION_SECRET=your_secure_session_secret
